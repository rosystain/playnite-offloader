<UserControl x:Class="Offloader.EnrolledGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10" TextElement.Foreground="{DynamicResource TextBrush}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource LOCoffloaderSetEnrolledTitle}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding EnrolledStatus}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="{DynamicResource LOCoffloaderListRefresh}" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Refresh_Click"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding EnrolledFilter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="{DynamicResource LOCoffloaderListSearchTooltip}" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="{DynamicResource LOCoffloaderListSearchHint}" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource LOCoffloaderListSortLabel}" VerticalAlignment="Center" Opacity="0.7"/>
                <ComboBox Width="110" SelectedIndex="{Binding EnrolledSortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource LOCoffloaderListSortName}"/>
                    <ComboBoxItem Content="{DynamicResource LOCoffloaderListSortLastPush}"/>
                    <ComboBoxItem Content="{DynamicResource LOCoffloaderListSortInstall}"/>
                </ComboBox>
                <Button Content="{Binding SortDirectionText}" Width="70" Margin="6,0,0,0" Click="SortDir_Click" ToolTip="{DynamicResource LOCoffloaderListSortToggle}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource LOCoffloaderListRemoveSelected}" Width="150" Click="Remove_Click"/>
            <Button Content="{DynamicResource LOCoffloaderListClose}" Width="80" Margin="6,0,0,0" Click="Close_Click"/>
        </StackPanel>
        <ListView x:Name="EnrolledList" ItemsSource="{Binding Enrolled}" SelectionMode="Extended" Margin="0,6,0,0"
                  Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ControlBackgroundBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{DynamicResource LOCoffloaderListColGame}" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource LOCoffloaderListSortInstall}" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InstallState}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource LOCoffloaderListSortLastPush}" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastPushText}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource LOCoffloaderListColLocalPath}" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LocalPath}" ToolTip="{Binding LocalPath}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
