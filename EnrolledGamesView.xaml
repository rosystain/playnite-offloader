<UserControl x:Class="Offloader.EnrolledGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10" TextElement.Foreground="{DynamicResource TextBrush}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="已启用清单" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="远端存在 GameId 目录即算启用（含空目录，靠下次推送自愈）。" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="刷新" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Refresh_Click"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding EnrolledFilter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="按游戏标题或 GameID 过滤" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="搜索游戏标题或 GameID…" Opacity="0.5" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                <TextBlock Text="排序：" VerticalAlignment="Center" Opacity="0.7"/>
                <ComboBox Width="110" SelectedIndex="{Binding EnrolledSortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="游戏名"/>
                    <ComboBoxItem Content="最后推送"/>
                    <ComboBoxItem Content="安装状态"/>
                </ComboBox>
                <Button Content="{Binding SortDirectionText}" Width="70" Margin="6,0,0,0" Click="SortDir_Click" ToolTip="切换升序 / 降序"/>
            </StackPanel>
            <TextBlock Text="{Binding EnrolledStatus}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="移除所选远端记录" Width="140" Click="Remove_Click"/>
            <Button Content="关闭" Width="80" Margin="6,0,0,0" Click="Close_Click"/>
        </StackPanel>
        <ListView x:Name="EnrolledList" ItemsSource="{Binding Enrolled}" SelectionMode="Extended" Margin="0,6,0,0"
                  Foreground="{DynamicResource TextBrush}" Background="{DynamicResource ControlBackgroundBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="游戏" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="安装状态" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InstallState}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="最后推送" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastPushText}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="本地路径" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LocalPath}" ToolTip="{Binding LocalPath}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
