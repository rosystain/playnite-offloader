<UserControl x:Class="Offloader.EnrolledGamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="远端存在 GameId 目录即算启用（含空目录，靠下次推送自愈）。移除 = 删除远端整个目录并清状态，不可恢复。" TextWrapping="Wrap" Opacity="0.7"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="刷新" Width="70" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Refresh_Click"/>
                <TextBox Text="{Binding EnrolledFilter, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="按游戏名 / GameId 过滤"/>
            </DockPanel>
            <TextBlock Text="按游戏名 / GameId 搜索：" Opacity="0.7" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding EnrolledStatus}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="移除所选远端记录" Width="140" Click="Remove_Click"/>
            <Button Content="关闭" Width="80" Margin="6,0,0,0" Click="Close_Click"/>
        </StackPanel>
        <ListView x:Name="EnrolledList" ItemsSource="{Binding Enrolled}" SelectionMode="Extended" Margin="0,6,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="游戏" Width="240" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="远端" Width="70" DisplayMemberBinding="{Binding RemoteState}"/>
                    <GridViewColumn Header="最后推送" Width="120" DisplayMemberBinding="{Binding LastPushText}"/>
                    <GridViewColumn Header="本地路径" Width="260" DisplayMemberBinding="{Binding LocalPath}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
